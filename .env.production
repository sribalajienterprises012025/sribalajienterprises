# Build-time defaults for the deployed app.
#
# Committed deliberately, and safe to commit: both values are published to every
# visitor's browser in the bundle anyway. The publishable key carries no
# privileges of its own — every read and write is checked against the row-level
# security policies in supabase/migrations.
#
# This is what removes "set two environment variables in Cloudflare" from the
# deploy. Real shell environment variables still take precedence over this file,
# so setting them in the Cloudflare dashboard continues to override these —
# which is how you would point a preview branch at a different project.
#
# The secret key (sb_secret_...) must never appear here. It bypasses every
# policy, and the app refuses to start if it finds one.

VITE_SUPABASE_URL=https://jaeynmolmvxtzllyqbyh.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_n7YPUFNrLaJaZvm95FkRkA_O-5Va_3G
