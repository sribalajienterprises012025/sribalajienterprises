# Supabase project credentials.
#
# Copy this file to .env.local for local development. In production these are
# set in Cloudflare Pages -> Settings -> Environment variables, for BOTH
# Production and Preview, and are never committed.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The browser key, from Project Settings -> API Keys.
#
# New projects issue a publishable key (sb_publishable_...); older ones an anon
# key, which is a JWT (eyJ...). Either works — both map to the `anon` Postgres
# role — so set whichever your project gives you. If both are set, the
# publishable one is used.
#
# This key is meant to be public: it carries no privileges of its own, and every
# read and write is checked against the row-level security policies.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# NEVER put the secret key (sb_secret_..., formerly service_role) in this file
# or in Cloudflare. It bypasses every RLS policy. The app refuses to start if it
# finds one.
