# The demo build. No real project is contacted: src/demo/backend.ts answers
# every Supabase request from data held in the browser, so this URL is never
# resolved and this key is never sent anywhere. It exists because the app
# rightly refuses to start without credentials.
VITE_DEMO=1
VITE_SUPABASE_URL=https://demo.balaji.invalid
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_demo_no_network_access
